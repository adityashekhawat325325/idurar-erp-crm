# Copy this file to .env and fill in the values

# MongoDB connection string (Atlas or local, e.g. mongodb://localhost:27017/idurar)
DATABASE="your-mongodb-uri"

# Secret used to sign login tokens – use any long random string
JWT_SECRET="change-me-to-a-long-random-string"

NODE_ENV="development"
OPENSSL_CONF="/dev/null"

# Public URL of this backend, used for file links in generated PDFs
PUBLIC_SERVER_FILE="http://localhost:8888/"

# Optional: port the backend listens on (default 8888)
# PORT=8888

# Optional: email sending (Resend) and AI features
# RESEND_API="your-resend-api-key"
# OPENAI_API_KEY="your-openai-api-key"

# Optional: DigitalOcean Spaces / S3 file storage
# DO_SPACES_KEY=""
# DO_SPACES_SECRET=""
# DO_SPACES_NAME=""
# DO_SPACES_URL=""
# REGION=""
